# Mẫu file .env của Lego Studio Engine. Đổi tên thành ".env" rồi điền giá trị sau dấu "=".
# File .env không bao giờ được commit. Đừng dán khóa vào cuộc trò chuyện.

# Khóa Gemini (Google AI Studio). Dùng từ Giai đoạn 3A.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_MODEL_STORYBOARD=
GEMINI_MODEL_FALLBACKS=

# (Tùy chọn) AI dự phòng kiểu OpenAI (Ollama, LM Studio, Groq...). Ví dụ Ollama:
# AI_FALLBACKS=LOCAL
# AI_LOCAL_URL=http://127.0.0.1:11434/v1
# AI_LOCAL_MODEL=qwen3:8b
AI_FALLBACKS=

# (Tùy chọn) Đường dẫn Blender nếu không cài ở chỗ mặc định.
BLENDER=
