{
  "name": "lego-studio-engine",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "bootstrap": "python bootstrap_studio.py",
    "doctor": "python apps/brick-engine/tools/studio_doctor.py",
    "produce": "python apps/brick-engine/produce.py"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vitest": "^5.1.1"
  }
}
